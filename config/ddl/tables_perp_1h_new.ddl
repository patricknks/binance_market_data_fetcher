-- ETHUSDT.P 1h with order book depth. Same layout as tables_perp.ddl plus 13 depth columns.
-- Same caveats as tables.ddl: search_path must point at the schema, and the table name
-- passed to the procedure must be lower case (it is quoted by format('%I', ...)).
--
-- Re-runnable: drops and recreates both tables, so a failed test run can start clean
-- under the same names.
SET search_path TO algo_oltp, public;

DROP TABLE IF EXISTS MARKET_DATA_ETHUSDTP_1H_NEW;
DROP TABLE IF EXISTS APPLICATION_ETHUSDTP_1H_NEW;

CREATE TABLE APPLICATION_ETHUSDTP_1H_NEW (
    ID INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    BUSINESS_DATE TIMESTAMP NOT NULL,
    UTC_DATE TIMESTAMP NOT NULL,
    UNIX_DATE NUMERIC(19,0) NOT NULL,
    INSERT_DATE TIMESTAMP
);


CREATE TABLE MARKET_DATA_ETHUSDTP_1H_NEW (
    ID INTEGER GENERATED BY DEFAULT AS IDENTITY,
    BUSINESS_DATE TIMESTAMP NOT NULL,
    UTC_DATE TIMESTAMP NOT NULL,
    UNIX_DATE NUMERIC(19,0) NOT NULL,
    INSERT_DATE TIMESTAMP,
    TICKER_NAME VARCHAR(12),
    OPEN_PRICE NUMERIC(20,8),
    HIGH_PRICE NUMERIC(20,8),
    LOW_PRICE NUMERIC(20,8),
    CLOSE_PRICE NUMERIC(20,8),
    CLOSE_PRICE_ADJUSTED NUMERIC(20,8),
    VOLUME NUMERIC(20,8),
    KLINE_CLOSE_TIME NUMERIC(19,0),
    QUOTE_ASSET_VOLUME NUMERIC(20,8),
    NUMBER_OF_TRADES INTEGER,
    TAKER_BUY_BASE_ASSET_VOLUME NUMERIC(20,8),
    TAKER_BUY_QUOTE_ASSET_VOLUME NUMERIC(20,8),
    LAST_TXN_CHECK NUMERIC(1,0),
    AVG_TRADE_SIZE NUMERIC(20,6),
    AGGRESSIVE_BUY_RATIO NUMERIC(10,4),
    PRICE_EFFICIENCY NUMERIC(10,4),
    TRADE_IMBALANCE NUMERIC(10,4),
    ICEBERG_SCORE NUMERIC(20,2),
    UPSIDE_PROBABILITY VARCHAR(30),
    PRICE_CHANGE NUMERIC(8,4),
    SUM_OPEN_INTEREST NUMERIC(20,8),
    SUM_OPEN_INTEREST_VALUE NUMERIC(20,8),
    CMC_CIRCULATING_SPLY NUMERIC(20,8),
    LONG_ACCOUNT NUMERIC(20,8),
    LS_RATIO NUMERIC(20,8),
    SHORT_ACCOUNT NUMERIC(20,8),
    -- Perpetual funding rate settles every 8 hours (00:00, 08:00, 16:00 UTC).
    -- Stored forward-filled: every row carries the rate in effect for that candle.
    FUNDING_RATE NUMERIC(20,8),
    -- Order book depth: cumulative notional (USDT) resting within N% of the mid price,
    -- averaged over the ~30-second snapshots that fall inside the candle.
    --   BID_* = bids between mid - N% and mid, ASK_* = asks between mid and mid + N%.
    --   Cumulative: the 1% band includes the 0.2% band.
    -- Null before 2023-01-01 (no bookDepth archive). The 0.2% band exists in the archive
    -- only from 2026-01-16; for the current day it comes from the live order book, and the
    -- 1..5% bands are filled the day after, once Binance publishes the archive.
    BID_NOTIONAL_0_2PCT NUMERIC(20,8),
    ASK_NOTIONAL_0_2PCT NUMERIC(20,8),
    BID_NOTIONAL_1PCT NUMERIC(20,8),
    ASK_NOTIONAL_1PCT NUMERIC(20,8),
    BID_NOTIONAL_2PCT NUMERIC(20,8),
    ASK_NOTIONAL_2PCT NUMERIC(20,8),
    BID_NOTIONAL_3PCT NUMERIC(20,8),
    ASK_NOTIONAL_3PCT NUMERIC(20,8),
    BID_NOTIONAL_4PCT NUMERIC(20,8),
    ASK_NOTIONAL_4PCT NUMERIC(20,8),
    BID_NOTIONAL_5PCT NUMERIC(20,8),
    ASK_NOTIONAL_5PCT NUMERIC(20,8),
    -- Snapshots averaged into the row. A full 1h candle has ~120; fewer means the candle
    -- was only partly observed (e.g. across a restart) until the archive replaces it.
    DEPTH_SAMPLES INTEGER,
	PRIMARY KEY (ID, BUSINESS_DATE),
	UNIQUE (BUSINESS_DATE, UNIX_DATE, UTC_DATE)
)
PARTITION BY RANGE (BUSINESS_DATE);
-- USD-M perpetual klines only start at 2020-01. Warmup also creates missing partitions
-- itself (app.warmup.auto-create-partition), so this range is a convenience, not a limit.
CALL create_partition_table_with_indexes('market_data_ethusdtp_1h_new', '2020-01-01', '2027-12-01');
